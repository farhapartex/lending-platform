APP_ENV=local
SERVICE_NAME=core-service
HTTP_PORT=8080
LOG_LEVEL=info

HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_GRACE_PERIOD=15s

DATABASE_URL=postgres://lending:lending@localhost:5432/lending?sslmode=disable
DATABASE_MAX_OPEN_CONNS=20
DATABASE_MAX_IDLE_CONNS=10
DATABASE_CONN_MAX_LIFETIME=30m
DATABASE_CONN_MAX_IDLE_TIME=5m
DATABASE_LOG_QUERIES=false

ID_MASK_SECRET=

REDIS_URL=redis://localhost:6379/0
CACHE_NAMESPACE=core-service
CACHE_REQUEST_TIMEOUT=2s

CHAIN_ID=31337
CHAIN_RPC_URL=http://localhost:8545
CHAIN_CONFIRMATIONS=1
CHAIN_REQUEST_TIMEOUT=15s

INDEXER_ENABLED=true
INDEXER_START_BLOCK=0
INDEXER_BATCH_SIZE=2000
INDEXER_POLL_INTERVAL=5s
SNAPSHOT_INTERVAL=60s

POOL_ADDRESS=
VAULT_ADDRESS=
CONTROLLER_ADDRESS=
LIQUIDATION_MANAGER_ADDRESS=
LENS_ADDRESS=
ORACLE_ADDRESS=
RATE_MODEL_ADDRESS=
COLLATERAL_TOKEN_ADDRESS=
DEBT_TOKEN_ADDRESS=
